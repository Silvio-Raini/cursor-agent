NODE_ENV=production
HOST=127.0.0.1
PORT=3450
TRUST_PROXY=true

# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

SESSION_MAX_AGE=604800
COOKIE_SECURE=true

# First admin (only created if no users exist)
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=ChangeMeNow!

# Cursor API key (optional here — can be set in UI under Settings)
CURSOR_API_KEY=

# Optional: comma-separated allowlist of project roots (not shown in UI)
# WORKSPACES=/home/you/projects

# Allow any absolute path (if WORKSPACES is empty)
AGENT_ALLOW_ANY_PATH=true

AGENT_MAX_CONCURRENT=2
AGENT_MAX_RUN_MS=7200000
AGENT_DEFAULT_MODEL=composer-2.5

PUBLIC_URL=https://your-domain.example
