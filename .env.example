NODE_ENV=production
HOST=127.0.0.1
PORT=3450
TRUST_PROXY=true

# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

SESSION_MAX_AGE=604800
COOKIE_SECURE=true

# First admin (only created if no users exist)
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=ChangeMeNow!

# Cursor API key (optional here — can be set in UI under Settings)
CURSOR_API_KEY=

# Comma-separated allowed workspace roots
WORKSPACES=/opt/apps,/opt/server-panel

AGENT_MAX_CONCURRENT=2
AGENT_MAX_RUN_MS=7200000
AGENT_DEFAULT_MODEL=composer-2.5
AGENT_ALLOW_ANY_PATH=false

PUBLIC_URL=https://cursor.codigoworks.com
